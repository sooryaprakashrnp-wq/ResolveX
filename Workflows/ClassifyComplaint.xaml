        <InArgument x:TypeArguments="x:Boolean" x:Key="in_AIEnabled">[in_AIEnabled]</InArgument>
        <InArgument x:TypeArguments="x:Boolean" x:Key="in_AIApproved">[in_AIApproved]</InArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
  </Sequence>
