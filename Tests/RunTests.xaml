    <ui:InvokeCode DisplayName="Assert demonstrated routes, idempotency and no sends" Language="VBNet" Code="If log.Rows.Count &lt;&gt; 13 Then Throw New InvalidOperationException(&quot;Expected 13 unique sample complaints after repeat run&quot;) Dim expected As String()() = {  New String(){&quot;demo-001&quot;,&quot;Flipkart&quot;,&quot;Order/Delivery&quot;,&quot;Order Support&quot;},  New String(){&quot;demo-002&quot;,&quot;Samsung&quot;,&quot;Warranty&quot;,&quot;Warranty and Service&quot;},  New String(){&quot;demo-003&quot;,&quot;Amazon&quot;,&quot;Refund&quot;,&quot;Payments and Refunds&quot;},  New String(){&quot;demo-004&quot;,&quot;Airtel&quot;,&quot;Technical&quot;,&quot;Technical Support&quot;},  New String(){&quot;demo-005&quot;,&quot;Unknown&quot;,&quot;Returns&quot;,&quot;Manual Review&quot;}} For Each e In expected  Dim rows = log.Rows.Cast(Of System.Data.DataRow)().Where(Function(r) Convert.ToString(r(&quot;GmailMessageID&quot;)) = e(0)).ToArray()  If rows.Length &lt;&gt; 1 Then Throw New InvalidOperationException(&quot;Duplicate or missing sample ID&quot;)  If Convert.ToString(rows(0)(&quot;Organization&quot;)) &lt;&gt; e(1) OrElse Convert.ToString(rows(0)(&quot;Category&quot;)) &lt;&gt; e(2) OrElse Convert.ToString(rows(0)(&quot;Department&quot;)) &lt;&gt; e(3) Then Throw New InvalidOperationException(&quot;Demo scenario failed: &quot; &amp; e(0)) Next If report.Rows.Count &lt;&gt; 5 Then Throw New InvalidOperationException(&quot;Expected top five outstanding complaints&quot;) If Convert.ToString(report.Rows(0)(&quot;Priority&quot;)) &lt;&gt; &quot;Critical&quot; OrElse Convert.ToString(report.Rows(1)(&quot;Priority&quot;)) &lt;&gt; &quot;High&quot; Then Throw New InvalidOperationException(&quot;Priority ranking failed&quot;) If System.IO.Directory.Exists(System.IO.Path.Combine(effectiveRoot,&quot;State&quot;,&quot;Dispatch&quot;)) Then Throw New InvalidOperationException(&quot;Sample must never attempt sending&quot;) System.IO.File.WriteAllText(System.IO.Path.Combine(effectiveRoot,&quot;Output&quot;,&quot;SampleTests.txt&quot;),&quot;PASS: five demonstration routes, duplicate prevention, 13 audit rows, top-five priority, no sends. &quot; &amp; DateTime.UtcNow.ToString(&quot;o&quot;))">
